<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-padding: 0;" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.estoquefx.controller.patrimonio.PatrimonioController">
    <top>
        <HBox spacing="10" style="-fx-padding: 8;" prefHeight="50">
        <Button onAction="#adicionarPatrimonio" text="%patrimonio.btn.add" />
            <Button onAction="#removerPatrimonio" text="%patrimonio.btn.remove" />
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtBusca" prefWidth="250" promptText="%patrimonio.search.prompt" />
        </HBox>
    </top>
    <center>
    <TableView fx:id="tabela">
        <columns>
            <TableColumn fx:id="colCodigo" prefWidth="55" text="%patrimonio.col.code" />
            <TableColumn fx:id="colNome" prefWidth="200" text="%patrimonio.col.name" />
            <TableColumn fx:id="colLocalizacao" prefWidth="150" text="%patrimonio.col.location" />
            <TableColumn fx:id="colEstado" prefWidth="100" text="%patrimonio.col.state" />
            <TableColumn fx:id="colDescricao" prefWidth="250" text="%patrimonio.col.description" />
            <TableColumn fx:id="colHora" prefWidth="150" text="%patrimonio.col.last_edit" />
        </columns>
    </TableView>
    </center>
    <bottom>
    <HBox maxHeight="25" style="-fx-background-color: #f0f0f0;           -fx-padding: 3 10 3 10;">
        <Label fx:id="lblResultados" style="-fx-font-size: 11px;" text="mostrando x de y" />
    </HBox>
    </bottom>
</BorderPane>
