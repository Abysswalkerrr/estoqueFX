<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.estoquefx.controller.estoque.TabelaController">
    <top>
        <HBox spacing="8" style="-fx-padding: 8;">
            <VBox>
                <Label fx:id="lblUltimaAlteracao" text="%tabela.saved_at"/>
                <Label fx:id="lblSaldoTotal" text="%tabela.total_balance"/>
            </VBox>
            <HBox spacing="5" style="-fx-padding: 4 8 2 8;">
                <VBox spacing="3">
                    <Button onAction="#onAdicionarProduto" text="%tabela.btn.add">
                        <graphic>
                            <FontIcon iconLiteral="fas-plus-circle" iconSize="14"/>
                        </graphic>
                    </Button>
                    <Button onAction="#onRemoverProduto" text="%tabela.btn.remove">
                        <graphic>
                            <FontIcon iconLiteral="fas-trash-alt" iconSize="14"/>
                        </graphic>
                    </Button>
                </VBox>
                <VBox spacing="3">
                    <Button onAction="#onEntrada" text="%tabela.btn.entry">
                        <graphic>
                            <FontIcon iconLiteral="fas-arrow-circle-up" iconSize="14"/>
                        </graphic>
                    </Button>
                    <Button onAction="#onSaida" text="%tabela.btn.exit">
                        <graphic>
                            <FontIcon iconLiteral="fas-arrow-circle-down" iconSize="14" />
                        </graphic>
                    </Button>
                </VBox>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox prefHeight="46.0" prefWidth="173.0" spacing="3.0">
                <ComboBox fx:id="boxCategorias" editable="true" prefHeight="26.0" prefWidth="174.0"
                          promptText="%tabela.filter.category.prompt"/>
                <CheckBox fx:id="boxApenasUrgente" mnemonicParsing="false" text="%tabela.filter.urgent"/>
            </VBox>

            <VBox spacing="3.0">
                <TextField fx:id="txtBusca" maxWidth="300" prefHeight="26.0" prefWidth="222.0"
                           promptText="%tabela.search.prompt" HBox.hgrow="SOMETIMES"/>
                <HBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnAtualizar" alignment="CENTER_RIGHT" onAction="#onAtualizar"
                            style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 5 15;"
                            text="%tabela.btn.refresh">
                        <graphic>
                            <FontIcon iconLiteral="fas-sync-alt" iconSize="14" fill="white"/>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tabela">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="45.0" text="%tabela.col.code"/>
                <TableColumn fx:id="colNome" prefWidth="111.4" text="%tabela.col.name"/>
                <TableColumn fx:id="colCategoria" prefWidth="103.0" text="%tabela.col.category"/>
                <TableColumn fx:id="colQtdMin" prefWidth="62.0" text="%tabela.col.min_qty"/>
                <TableColumn fx:id="colValorUnd" prefWidth="93.0" text="%tabela.col.unit_value"/>
                <TableColumn fx:id="colQtd" prefWidth="67.0" text="%tabela.col.qty"/>
                <TableColumn fx:id="colOrientacao" prefWidth="96.0" text="%tabela.col.orientation"/>
                <TableColumn fx:id="colSaldo" prefWidth="64.0" text="%tabela.col.balance"/>
                <TableColumn fx:id="colHora" prefWidth="75.0" text="%tabela.col.last_edit"/>
                <TableColumn fx:id="colDescricao" text="%tabela.col.location"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" maxHeight="25" spacing="15"
              style="-fx-background-color: #f0f0f0; -fx-padding: 3 10 3 10;">
            <Label fx:id="lblResultados" style="-fx-font-size: 11px;" text="X DE Y"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </bottom>

</BorderPane>
